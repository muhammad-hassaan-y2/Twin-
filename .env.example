# .env.example — put this in Twin/ and fill in real values for PayPal sandbox access.

# PayPal Sandbox OAuth2 credentials (required for real API calls).
# Get these from the PayPal Developer Dashboard:
#   https://developer.paypal.com/app/developer/accounts/
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_SECRET=your-paypal-sandbox-secret

# If these are omitted or empty the app will short‑circuit the PayPal call
# and return state=UNKNOWN, allowing you to test the oversight guard
# (402 FAILED) without network credentials.