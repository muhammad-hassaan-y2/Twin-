# Dependencies and build output
node_modules/
dist/
*.tsbuildinfo

# Local runtime state, credentials and generated TLS material
.env
.env.*
.iwsdk/

# A live table is accounts, tokens, decisions and payment records. The worlds are in
# PostgreSQL now, so a database file in this directory is an accident — from the version
# that kept them in one, or from somebody's experiment — and it stays out of the repo.
*.db
*.db-wal
*.db-shm

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# The harvested EU corpus. Raw statute XHTML and every cell of a Eurostat table are
# megabytes of somebody else's published text; only the manifest and the derived priors
# are tracked, because those are the parts this repository is answerable for.
.corpus/
*.journal.jsonl
.journal.jsonl

# Renders the verification loop produced to prove a panel was where the code said it
# was. They are evidence about one run on one machine, not inputs to the app, and the
# chain's own artifacts are tracked because the sidecar loads them.
web/artifacts/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
