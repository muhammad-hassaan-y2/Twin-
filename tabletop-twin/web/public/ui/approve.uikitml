<div class="card">
  <style>
    .card {
      display: flex;
      flex-direction: column;
      width: 44;
      padding: 3.4;
      gap: 2.2;
      background-color: #10151c;
      border-color: #ffd166;
      border-width: 0.8;
      border-radius: 2.2;
    }
    .title {
      font-size: 2.1;
      font-weight: 700;
      color: #ffd166;
    }
    .body {
      font-size: 2.4;
      color: #f2e8c9;
    }
    .hint {
      font-size: 1.7;
      color: #8fa1b3;
    }
    .row {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
    }
    .reject {
      font-size: 1.9;
      color: #f2e8c9;
      background-color: #1f2a36;
      border-color: #4a5f74;
      border-width: 0.5;
      border-radius: 1.4;
      padding-top: 1.2;
      padding-bottom: 1.2;
      padding-left: 2.2;
      padding-right: 2.2;
      cursor: pointer;
    }
  </style>
  <span class="title">Holding for your pinch</span>
  <span id="ApproveText" class="body">Nothing is waiting.</span>
  <span class="hint">Hold the coin one second, or tap reject.</span>
  <div class="row">
    <button id="Btn-reject" class="reject">Reject</button>
  </div>
</div>
