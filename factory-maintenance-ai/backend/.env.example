# Database
DATABASE_URL=sqlite:///./factory_maintenance.db

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_EXTENSIONS=jpg,jpeg,png

# AI/LLM (Optional - for future integration)
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=

# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production