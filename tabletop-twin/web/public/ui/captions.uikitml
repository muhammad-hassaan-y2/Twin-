<div id="CaptionCard" class="card">
  <style>
    .card {
      display: flex;
      flex-direction: column;
      width: 76;
      padding: 4;
      gap: 2.4;
      background-color: #10151c;
      border-color: #33414f;
      border-width: 0.8;
      border-radius: 3;
    }
    .band {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding-top: 1.8;
      padding-bottom: 1.8;
      padding-left: 2.4;
      padding-right: 2.4;
      background-color: #1a222c;
      border-radius: 2;
    }
    .chip {
      font-size: 2.4;
      font-weight: 700;
      color: #0e1116;
      background-color: #9aa5b1;
      padding-top: 0.9;
      padding-bottom: 0.9;
      padding-left: 2;
      padding-right: 2;
      border-radius: 1.2;
    }
    .bandnote {
      font-size: 2.2;
      color: #f2e8c9;
    }
    .byline {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    .meta {
      font-size: 2.2;
      color: #9aa5b1;
    }
    .caption {
      font-size: 3.6;
      line-height: 1.34;
      color: #f2e8c9;
      text-align: left;
    }
    .asks {
      display: flex;
      flex-direction: column;
      gap: 1.8;
    }
    .row {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
    }
    .ask {
      font-size: 2.4;
      font-weight: 600;
      color: #f2e8c9;
      background-color: #1a222c;
      border-color: #4a5f74;
      border-width: 0.6;
      border-radius: 1.6;
      padding-top: 1.8;
      padding-bottom: 1.8;
      padding-left: 3.2;
      padding-right: 3.2;
      cursor: pointer;
    }
  </style>
  <span id="CaptionBand" class="band">
    <span id="CaptionStep" class="chip">waking</span>
    <span id="CaptionRoute" class="bandnote">planner: not reached</span>
  </span>
  <span class="byline">
    <span id="CaptionWho" class="meta">this table</span>
    <span id="CaptionKind" class="meta">step: idle</span>
    <span id="CaptionDay" class="meta">day 1 of 90</span>
  </span>
  <span id="CaptionText" class="caption">Waking the miniature.</span>
  <span class="asks">
    <span class="row">
      <button id="Btn-why" class="ask">Why so thin?</button>
      <button id="Btn-driest" class="ask">Worst day</button>
    </span>
    <span class="row">
      <button id="Btn-cancel" class="ask">Cancel a sub</button>
      <button id="Btn-best" class="ask">Best move</button>
    </span>
  </span>
</div>
