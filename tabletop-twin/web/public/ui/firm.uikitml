<div id="FirmCard" class="card">
  <style>
    .card {
      display: flex;
      flex-direction: column;
      width: 56;
      padding: 3.4;
      gap: 1.6;
      background-color: #10151c;
      border-color: #33414f;
      border-width: 0.7;
      border-radius: 2.6;
    }
    .band {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 2;
    }
    .eyebrow {
      font-size: 2;
      font-weight: 700;
      color: #9aa5b1;
      text-align: left;
    }
    .state {
      font-size: 1.9;
      font-weight: 700;
      color: #0e1116;
      background-color: #9aa5b1;
      padding-top: 0.6;
      padding-bottom: 0.6;
      padding-left: 1.4;
      padding-right: 1.4;
      border-radius: 1;
    }
    .client {
      font-size: 3;
      font-weight: 700;
      line-height: 1.2;
      color: #f2e8c9;
      text-align: left;
    }
    .line {
      font-size: 2.2;
      line-height: 1.25;
      color: #7fb3d5;
      text-align: left;
    }
    .quiet {
      font-size: 2.2;
      line-height: 1.25;
      color: #9aa5b1;
      text-align: left;
    }
    .divider {
      height: 0.6;
      background-color: #33414f;
      border-radius: 0.3;
    }
    .finding {
      font-size: 2.4;
      line-height: 1.3;
      color: #f2e8c9;
      text-align: left;
    }
    .reason {
      font-size: 2;
      line-height: 1.3;
      color: #e4572e;
      text-align: left;
    }
    .ask {
      font-size: 2.2;
      font-weight: 600;
      color: #0e1116;
      background-color: #7fb3d5;
      border-color: #7fb3d5;
      border-width: 0.5;
      border-radius: 1.4;
      padding-top: 1.5;
      padding-bottom: 1.5;
      padding-left: 2.6;
      padding-right: 2.6;
      cursor: pointer;
    }
  </style>
  <div class="band">
    <span class="eyebrow">THE FIRM AT THIS TABLE</span>
    <span id="FirmState" class="state">no contract</span>
  </div>
  <span id="FirmRoles" class="quiet">no roles hired yet</span>
  <span id="FirmCorpus" class="quiet">no corpus read yet</span>
  <div class="divider"></div>
  <span id="FirmClient" class="client">nothing asked yet</span>
  <span id="FirmTally" class="line"></span>
  <span id="FirmHeadline" class="finding">Nothing has been put to the firm.</span>
  <div class="divider"></div>
  <span id="FirmAgreements" class="line"></span>
  <span id="FirmReason" class="reason"></span>
  <span id="FirmNote" class="quiet"></span>
  <button id="Btn-firm" class="ask">Put the next engagement to the firm</button>
</div>
