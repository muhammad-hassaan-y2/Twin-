<div id="WheelCard" class="plate">
  <style>
    .plate {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.8;
      width: 34;
      padding-top: 2.2;
      padding-bottom: 2.2;
      padding-left: 3;
      padding-right: 3;
      background-color: #10151c;
      border-color: #4a5f74;
      border-width: 0.7;
      border-radius: 2.2;
    }
    .eyebrow {
      font-size: 1.9;
      font-weight: 700;
      color: #9aa5b1;
    }
    .day {
      font-size: 4.4;
      font-weight: 700;
      line-height: 1.1;
      color: #ffd166;
      text-align: center;
    }
    .span {
      font-size: 2.2;
      color: #f2e8c9;
      text-align: center;
    }
    .hint {
      font-size: 1.9;
      color: #9aa5b1;
      text-align: center;
    }
  </style>
  <span class="eyebrow">TIME WHEEL</span>
  <span id="WheelDay" class="day">day 1</span>
  <span id="WheelSpan" class="span">of 90 days</span>
  <span class="hint">twist to scrub</span>
</div>
